# Yerel gelistirme icin bu dosyayi .env olarak kopyalayin. Bulutta bu degerler Secret Manager'dan gelir.
# .env depoya GIRMEZ.

SAAS_ORTAM=yerel                 # yerel | bulut
SAAS_DEPO=yerel                  # yerel (SQLite + klasor) | supabase
SAAS_TETIK=yerel                 # yerel (alt surec) | cloudrun | yok
SAAS_YEREL_GIRIS=1               # sadece yerel: e-postayla sahte giris (bulutta 0)
SAAS_GENEL_ADRES=http://localhost:8800

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=           # yalnizca eski (HS256) projeler; yeni projelerde bos birakin

# Guvenlik (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
SAAS_SIFRELEME_ANAHTARI=
SAAS_IMZA_ANAHTARI=              # uzun rastgele metin
SAAS_ZAMANLAYICI_ANAHTARI=       # uzun rastgele metin

# Meta uygulamasi (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=

# Yapay zeka
AJAN_YZ_SAGLAYICI=gemini
GEMINI_API_KEY=

# Google Cloud (isci tetikleme)
GCP_PROJE=
GCP_BOLGE=europe-west1
SAAS_ISCI_IS_ADI=ajan-isci
