# Ayarlar. Yerel deneme icin bu dosyayi .env olarak kopyalayin; VPS'te deploy/vps/kur.sh doldurur.
# .env depoya GIRMEZ. Aciklamalar ayri satirda olmali (degerin yanina yorum yazmayin).

# yerel | bulut
SAAS_ORTAM=yerel
# yerel (SQLite + klasor) | supabase
SAAS_DEPO=yerel
# yerel (alt surec) | surekli (VPS) | cloudrun | yok
SAAS_TETIK=yerel
# sadece yerel gelistirme: e-postayla sahte giris (bulutta 0)
SAAS_YEREL_GIRIS=1
SAAS_GENEL_ADRES=http://localhost:8800
# VPS: panelin alan adi (HTTPS sertifikasi bunun icin alinir)
SAAS_ALAN_ADI=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Guvenlik: kur.sh uretir. Sifreleme anahtarini yedekleyin.
SAAS_SIFRELEME_ANAHTARI=
SAAS_IMZA_ANAHTARI=
SAAS_ZAMANLAYICI_ANAHTARI=

# Meta uygulamasi (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=

# Yapay zeka: openai = OpenAI uyumlu servis (DigitalOcean Serverless Inference), gemini, ollama
AJAN_YZ_SAGLAYICI=openai
AJAN_YZ_URL=https://inference.do-ai.run/v1
AJAN_YZ_MODEL=llama3.3-70b-instruct
AJAN_YZ_ANAHTAR=
GEMINI_API_KEY=
